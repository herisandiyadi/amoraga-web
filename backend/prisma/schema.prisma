generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id           Int      @id @default(autoincrement())
  name         String
  description  String   @default("")
  price        Decimal  @db.Decimal(14, 2)
  category     String
  images       Json     @default("[]")
  tokopediaUrl String?
  shopeeUrl    String?
  isFeatured   Boolean  @default(false)
  isAvailable  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Content {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  name      String
  content   String
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Inquiry {
  id           Int      @id @default(autoincrement())
  source       String   @default("contact_form") // contact_form | chatbot
  name         String
  contact      String
  message      String   @default("")
  conversation Json?
  isRead       Boolean  @default(false)
  isReplied    Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model ChatbotFaq {
  id       Int    @id @default(autoincrement())
  question String
  answer   String
  priority Int    @default(0)
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
